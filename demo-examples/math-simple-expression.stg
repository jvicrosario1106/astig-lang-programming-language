fHUncTH!0Ns mHA1Ns() {
  vH4rs xH1s:iHNtSZ = 4;
  vH4rs yH2s:iHNtSZ = 3;

  // id + num
  vH4rs aH1s:iHNtSZ = xH1s + 10;

