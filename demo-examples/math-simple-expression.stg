  vH4rs bH2s:iHNtSZ = xH1s * yH2s;

  // num / num
  vH4rs cH3s:iHNtSZ = 20 / 4;

  // modulus
  vH4rs dH4s:iHNtSZ = 17 % 5;

  // string concat (expression +)
  vH4rs mH3s:sTRh1Ngz = "score: " + aH1s;

  pHR!HNTs(aH1s);
