  }

  /* while, do-while, for, foreach */
  vH4rs cH0uHNtHs:iHNtSZ = 0;
  wH1lEs(cH0uHNtHs < 3) {
    cH0uHNtHs += 1;
  }

  vH4rs tH4skH3s:iHNtSZ = 2;
  dH0s {
    pHR!HNTs(tH4skH3s);
    tH4skH3s -= 1;
  } wH1lEs(tH4skH3s > 0);

  fH0rs(vH4rs iH1s:iHNtSZ = 0; iH1s < 3; iH1s = iH1s + 1) {
    pHR!HNTs(iH1s);
