// AstigLang syntax showcase — covers major language features for parser/scanner demos.

iHNcHLuHD3s libHs.stg

rH3cH0rHDz pH0iHNtHs {
  xH1s:iHNtSZ,
  yH2s:iHNtSZ
}

rH3cH0rHDz gH4mH3s {
  sHC0rH3s:iHNtSZ,
