fHUncTH!0Ns mHA1Ns() {
  /* declarations: const, var, let */
  c0hNsTz nH4mH3s:sTRh1Ngz = "Astig";
  lH3tsz sHC0rH3s:iHNtSZ = 88;
  vH4rs gH4dH3s:sTRh1Ngz = "pending";
  vH4rs rH4tHs:fHLoaTHsz = 3.14;
  vH4rs pH4ssHs:bH0oHLeaNs = TrU3hS;

  /* arithmetic, modulus, compound assignment */
  vH4rs sH0mH3s:iHNtSZ = sHC0rH3s + 10 - 2 * 3 / 2;
  sH0mH3s += 5;
  sH0mH3s -= 2;
  vH4rs rH3mHs:iHNtSZ = sH0mH3s % 7;

  /* logical operators: nH0ts, aHNdz, 0hrS */
  !HFs((pH4ssHs 0hrS nH0ts FhaLSeS) aHNdz sH0mH3s > 0) {
